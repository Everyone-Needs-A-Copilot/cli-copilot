{
  "mcpServers": {
    "copilot-memory": {
      "command": "node",
      "args": ["YOUR_HOME/.claude/copilot/mcp-servers/copilot-memory/dist/index.js"],
      "env": {
        "MEMORY_PATH": "YOUR_HOME/.claude/memory",
        "WORKSPACE_ID": "cli-copilot"
      }
    },
    "skills-copilot": {
      "command": "node",
      "args": ["YOUR_HOME/.claude/copilot/mcp-servers/skills-copilot/dist/index.js"],
      "env": {
        "LOCAL_SKILLS_PATH": "./.claude/skills"
      }
    }
  }
}
