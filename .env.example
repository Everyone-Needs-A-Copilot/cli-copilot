# =============================================================================
# CLI Copilot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# This template includes CLI-related keys only.
# =============================================================================

# --- General ---
LOG_LEVEL=info

# --- Usage ledger (usage-frequency audit finding; see copilot_cli/shared/usage_ledger.py) ---
# Opt-in, append-only invocation log at ~/.copilot-cli/usage.jsonl (path
# override: COPILOT_USAGE_LOG_PATH). Records only the resolved command path,
# exit code and duration -- never argument/option values.
# IMPORTANT: this repo never calls python-dotenv's load_dotenv(), so a value
# in .env alone does NOT reach os.environ (pydantic-settings' env_file only
# populates the declared Settings() fields in config/settings.py, not
# arbitrary keys). To actually enable the ledger, export it in your shell,
# e.g. add to ~/.zshrc: export COPILOT_USAGE_LOG=1
# COPILOT_USAGE_LOG=1

# --- Coolify ---
COOLIFY_BASE_URL=https://coolify.example.com
# Prefer one of the two below (ACCESS_TOKEN takes precedence if both are set)
COOLIFY_ACCESS_TOKEN=
COOLIFY_API_KEY=

# Optional Coolify SSH config
# COOLIFY_SSH_HOST=
# COOLIFY_SSH_USER=root
# COOLIFY_SSH_PORT=22
# COOLIFY_SSH_KEY_FILE=~/.ssh/id_ed25519

# Optional Coolify defaults
# COOLIFY_DEFAULTS_OUTPUT_FORMAT=table
# COOLIFY_DEFAULTS_PAGE_SIZE=50
# COOLIFY_DEFAULTS_LOG_LINES=100

# Optional Coolify monitoring overrides
# COOLIFY_MONITORING_DASHBOARD_REFRESH=2
# COOLIFY_MONITORING_HEALTH_CHECK_INTERVAL=30
# COOLIFY_MONITORING_SSL_WARN_DAYS=30
# COOLIFY_MONITORING_CPU_THRESHOLD=80
# COOLIFY_MONITORING_MEMORY_THRESHOLD=85
# COOLIFY_MONITORING_DISK_THRESHOLD=90
# COOLIFY_MONITORING_RESPONSE_TIME_MS=2000

# --- Infisical ---
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# INFISICAL_BASE_URL defaults to https://app.infisical.com (Infisical Cloud);
# point it at your self-hosted instance if you run one
# INFISICAL_BASE_URL=https://app.infisical.com
# INFISICAL_ORG_ID=  # auto-discovered from identity if unset

# --- n8n ---
N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_API_KEY=your-n8n-api-key

# --- Git ---
GIT_USER_NAME=your-git-username
GIT_USER_EMAIL=your-email@example.com

# --- Docker ---
DOCKER_SOCKET=/var/run/docker.sock

# --- Shell ---
# SHELL_SCRIPTS_PATH must be set explicitly (no default — platform-dependent)
SHELL_SCRIPTS_PATH=/path/to/scripts
SHELL_TIMEOUT=3600

# --- Filesystem ---
# ALLOWED_VOLUMES must be set explicitly (default is /tmp only)
ALLOWED_VOLUMES=/tmp,/home/user/data
MAX_FILE_SIZE_MB=10

# --- NocoDB (CRM) ---
NOCODB_URL=https://your-nocodb-instance.example.com
NOCODB_API_KEY=your-nocodb-api-key
NOCODB_BASE_ID=your-nocodb-base-id

# --- Brevo ---
BREVO_API_KEY=your-brevo-api-key

# --- PostgreSQL Databases ---
DATABASE_URL=postgresql://user:password@localhost:5432/main
NOCODB_DATABASE_URL=postgresql://user:password@localhost:5432/nocodb
N8N_DATABASE_URL=postgresql://user:password@localhost:5432/n8n
FORMBRICKS_DATABASE_URL=
# BACKUP_DIR — local directory `copilot db backup`/`transfer` write dumps to
BACKUP_DIR=~/copilot-backups

# --- Discord Handoffs ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# DISCORD_GUILD_ID — only needed by the live Playwright e2e test
# (tests/e2e/test_discord_playwright_bridge.py) to build thread URLs; point it
# at your own test server, never a shared one.
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_ALLOWED_USER_IDS=
DISCORD_WEBHOOK_USERNAME=
DISCORD_WEBHOOK_AVATAR_URL=
# DISCORD_WAIT_TIMEOUT — seconds `discord wait` parks the session in away-mode;
# 0 (default) waits forever
DISCORD_WAIT_TIMEOUT=0
# COPILOT_DISCORD_WAIT_TIMEOUT — same override read directly by the away-mode
# hook (hook.py); set instead of/in addition to DISCORD_WAIT_TIMEOUT if the
# hook must use a different value than the rest of the CLI
COPILOT_DISCORD_WAIT_TIMEOUT=

# --- USPTO CLI / Copilot ---
USPTO_CLI_BASE_URL=
USPTO_CLI_API_KEY=
USPTO_COPILOT_AUTH_SECRET=
# USPTO_TSDR_BASE_URL defaults to https://tsdrapi.uspto.gov
# USPTO_TSDR_BASE_URL=https://tsdrapi.uspto.gov

# --- Monitoring Thresholds ---
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90

# --- Skills ---
# Additional skill search paths (comma-separated in settings, colon-separated in env)
# The CLI always searches .claude/skills/ relative to the project root.
# Use SKILL_PATHS to add shared skill directories (colon-separated, Unix convention):
# SKILL_PATHS=/path/to/knowledge-copilot/03-ai-enabling/01-skills:/other/skills
# Or use skill_paths in settings (comma-separated):
# SKILL_PATHS=
